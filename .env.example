OPENAI_API_KEY=
# On Linux, set these to the owner of the mounted data directory (id -u / id -g).
# ANIMALCAM_UID=1000
# ANIMALCAM_GID=1000
ANIMALCAM_MODEL=gpt-6-luna
ANIMALCAM_IMAGE_WIDTH=960
# OPENAI_BASE_URL=https://api.openai.com/v1
ANIMALCAM_INTERVAL_MIN=15
ANIMALCAM_ALERT_THRESHOLD=6
ANIMALCAM_COOLDOWN_MIN=60
# 0 keeps every image. Otherwise only empty, unalerted images expire.
ANIMALCAM_RETENTION_DAYS=0
# Runs immediately on startup as well as on schedule. Check now works either way.
ANIMALCAM_RUN_ON_START=1
# Set to 0 for manual checks only.
ANIMALCAM_SCHEDULE_ENABLED=1
ALERT_BACKEND=none
# ALERT_BACKEND=ntfy
# NTFY_TOPIC=pick-a-long-random-topic
# NTFY_TOKEN=
# Optional Discord webhook; ALERT_BACKEND=discord
# WEBHOOK_URL=
# Optional authentication for every dashboard/API/image request.
# DASHBOARD_USER=animalcam
# DASHBOARD_PASSWORD=
# YTDLP_COOKIES=/data/cookies.txt
